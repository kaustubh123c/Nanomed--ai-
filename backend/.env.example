# MongoDB Atlas. Set this in your local .env or hosting environment; never commit credentials.
MONGO_URI=mongodb+srv://radshieldai_db_user:REPLACE_WITH_ROTATED_PASSWORD@cluster0.yuiwy5v.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=nanomed_ai

# Generate a unique secret (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Gemini chatbot (optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# Comma-separated frontend origins; update after deployment
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Physics source: xcom (live NIST access) or offline (fallback)
MAC_DATA_SOURCE=xcom
